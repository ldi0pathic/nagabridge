name: Strict CI

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]

jobs:
  quality:
    name: Strict Code Quality Gate
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      # 🔍 Linting (strenger als Standard)
      - name: Ruff (strict)
        run: ruff check src/ tests/ --select ALL --ignore D203,D212

      # 🎨 Format Check
      - name: Black
        run: black --target-version py312 --check src/ tests/

      # 🔐 Security
      - name: Bandit
        run: bandit -r src/ -ll

      # 🧠 Typprüfung
      - name: Mypy (strict)
        run: mypy src/ --strict

      # 📉 Komplexität begrenzen
      - name: Xenon complexity gate
        run: xenon --max-absolute B --max-modules A --max-average A src/

      # 🧪 Tests + Coverage
      - name: Pytest with coverage
        run: pytest tests/ -v --cov=src --cov-report=term --cov-fail-under=80
